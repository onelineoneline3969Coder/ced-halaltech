# ==========================================
# 🛡️ CED HalalTech .gitignore
# Protection des Données Sensibles & Secrets
# Conforme Politique de Sécurité (SECURITY.md)
# ==========================================

# --- 1. Secrets & Identifiants (CRUCIAL - FINMA/AAOIFI) ---
# Ne jamais committer ces fichiers sous aucun prétexte
.env
.env.local
.env.production
.env.swiss
*.key
*.pem
*.crt
*.p12
secrets.json
credentials.yaml
config.private.php
database.yml
infomaniak_api_key.txt
aws_credentials
azure_credentials.json

# --- 2. Logs & Traces d'Exécution (Confidentialité Utilisateurs) ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pm2.log
pm2.err.log
debug.log
error.log
access.log
transaction_logs/
audit_trails_local/

# --- 3. Dépendances & Build (Node.js, Python, etc.) ---
node_modules/
dist/
build/
vendor/
*.min.js
*.min.css
__pycache__/
*.pyc
*.pyo
.venv/
env/
.parcel-cache/

# --- 4. Sauvegardes & Archives Locales (Infomaniak Backup) ---
# Le script backup.sh est gardé, mais PAS ses sorties
backup/
backups/
dumps/
*.tar.gz
*.sql
*.dump
*.bak
!scripts/backup.sh

# --- 5. Éditeurs de Code & OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
*.sublime-project
*.sublime-workspace

# --- 6. Données Utilisateurs & Tests (RGPD/LPD) ---
# Jamais de données réelles dans le repo
test_data/
mock_users.json
dummy_credentials.txt
uploads/
downloads/

# --- 7. Certificats & Keys de Production ---
prod_ssl/
live_keys/
ssl_certificates/
!ssl_certificates/README.md
